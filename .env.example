# === Frontend (Vite) ===
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Bloqueio por assinatura no cliente.
# false = geração aberta (dev/testes). true = só assinantes ativos acessam.
VITE_ENFORCE_SUBSCRIPTION=false

# ===================================================================
# Secrets do SERVIDOR (Supabase → Edge Functions → Secrets). NÃO vão no .env do frontend.
# ===================================================================
# STRIPE_SECRET_KEY=sk_test_...            # chave secreta da Stripe
# STRIPE_WEBHOOK_SECRET=whsec_...          # segredo do endpoint de webhook
# STRIPE_PRICE_INDIVIDUAL=price_...        # Price do plano Individual (R$29,90/mês)
# STRIPE_PRICE_IGREJA=price_...            # Price do plano Igreja (R$99,90/mês)
# APP_URL=http://localhost:5173            # base p/ success/cancel/return do checkout
# ENFORCE_SUBSCRIPTION=false               # gate no servidor (edge `gerar`); true p/ exigir assinatura
